// Append these models to the END of schema.prisma

model AccountingPeriod {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  startDate  DateTime
  endDate    DateTime
  year       Int
  status     PeriodStatus @default(DRAFT)
  costItems  CostItem[]
  advancePayments AdvancePayment[]
  createdAt  DateTime @default(now())
  finalizedAt DateTime?
}

model CostCategory {
  id             String   @id @default(cuid())
  name           String
  nameDE         String
  allocationType AllocationMethod
  isAllocable    Boolean  @default(true)
  betrkvSection  String?
  sortOrder      Int      @default(0)
  costItems      CostItem[]
}

model CostItem {
  id              String @id @default(cuid())
  periodId        String
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  categoryId      String
  category        CostCategory @relation(fields: [categoryId], references: [id])
  totalAmount     Decimal
  allocableAmount Decimal?
  description     String?
  invoiceNumber   String?
  invoiceDate     DateTime?
  createdAt       DateTime @default(now())
}

model ConsumptionMeter {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  meterType   MeterType
  meterNumber String
  location    String?
  readings    MeterReading[]
  createdAt   DateTime @default(now())
}

model MeterReading {
  id            String   @id @default(cuid())
  meterId       String
  meter         ConsumptionMeter @relation(fields: [meterId], references: [id])
  readingDate   DateTime
  value         Decimal
  previousValue Decimal?
  consumption   Decimal?
  notes         String?
  createdAt     DateTime @default(now())
}

model AdvancePayment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  periodId      String
  period        AccountingPeriod @relation(fields: [periodId], references: [id])
  monthlyAmount Decimal
  monthsPaid    Int
  totalPaid     Decimal
  startMonth    DateTime
  endMonth      DateTime
  createdAt     DateTime @default(now())
}

enum PeriodStatus {
  DRAFT
  FINALIZED
  SENT
  ARCHIVED
}

enum AllocationMethod {
  PER_UNIT
  PER_SQM
  PER_PERSON
  CONSUMPTION
  MEA
  HEATING_MIXED
}

enum MeterType {
  HEATING
  HOT_WATER
  COLD_WATER
  ELECTRICITY
  GAS
}
